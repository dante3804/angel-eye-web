# 침대 구역 지정 도구
# ----------------------------------------------------------------------------
def pick_zone(frame, out_path: str = "rest_zone.json") -> None:
    import cv2
 
    pts: list[tuple[float, float]] = []
    h, w = frame.shape[:2]
    win = "rest zone (click=point, s=save, q=quit)"
 
    def on_mouse(event, x, y, flags, param):
        if event == cv2.EVENT_LBUTTONDOWN:
            pts.append((x / w, y / h))
 
    cv2.namedWindow(win)
    cv2.setMouseCallback(win, on_mouse)
    while True:
        vis = frame.copy()
        if pts:
            poly = np.array([[int(x * w), int(y * h)] for x, y in pts], np.int32)
            cv2.polylines(vis, [poly], len(pts) > 2, (0, 220, 255), 2)
            for p in poly:
                cv2.circle(vis, tuple(p), 4, (0, 220, 255), -1)
        cv2.imshow(win, vis)
        k = cv2.waitKey(20) & 0xFF
        if k == ord("s") and len(pts) >= 3:
            Path(out_path).write_text(json.dumps({"polygon": pts}, indent=2))
            print(f"저장됨: {out_path}")
            break
        if k == ord("q"):
            break
    cv2.destroyAllWindows()
 
 
if __name__ == "__main__":
    import argparse
    import cv2
 
    ap = argparse.ArgumentParser()
    ap.add_argument("--pick", action="store_true", help="침대/소파 구역 지정")
    ap.add_argument("--source", default="0")
    args = ap.parse_args()
 
    if args.pick:
        src = int(args.source) if args.source.isdigit() else args.source
        cap = cv2.VideoCapture(src)
        ok, frame = cap.read()
        cap.release()
        if ok:
            pick_zone(frame)
        else:
            print("프레임을 가져오지 못했습니다.")
